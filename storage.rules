rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // 案件の写真：ログインした人が閲覧、管理者だけが追加
    match /jobs/{jobId}/{file} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && isImage();
    }

    // 完了報告の写真：発注先の本人だけが追加、本人と管理者が閲覧
    match /reports/{jobId}/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.assignedTo == uid
        && isImage();
    }
  }
}
